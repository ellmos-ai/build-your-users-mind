{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ellmos-ai/build-your-users-mind/schemas/avatar-rating-input.schema.json",
  "title": "BYUM avatar decision rating input",
  "type": "object",
  "required": ["schema", "run_id", "entries"],
  "properties": {
    "schema": {"const": "byum.avatar-rating-input.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kontext", "entscheidung", "konfidenz", "ziel"],
        "properties": {
          "nr": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "kontext": {"type": "string"},
          "entscheidung": {"type": "string", "minLength": 1},
          "konfidenz": {"type": "string", "minLength": 1},
          "ziel": {"type": "string", "minLength": 1},
          "ebene": {"type": "string"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "ticket_id": {"type": "string"},
          "decision_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
